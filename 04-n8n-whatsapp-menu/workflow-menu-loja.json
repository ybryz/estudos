    {
      "parameters": {
        "jsCode": "// Normaliza o texto (minúsculas, sem acento, sem espaços nas pontas) e descobre a opção.\nconst texto = String($input.first().json.chatInput ?? '')\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .trim()\n  .toLowerCase();\n\nconst opcoes = {\n  horario: ['1', 'horario'],\n  endereco: ['2', 'endereco'],\n  pessoa: ['3', 'pessoa', 'atendente'],\n  menu: ['menu', 'oi', 'ola', 'bom dia', 'boa tarde', 'boa noite'],\n};\n\nlet opcao = 'invalida';\nfor (const [nome, aceitos] of Object.entries(opcoes)) {\n  if (aceitos.includes(texto)) opcao = nome;\n}\n\nreturn [{ json: { opcao } }];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Descobre opcao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.opcao }}", "rightValue": "horario", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "horario"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
