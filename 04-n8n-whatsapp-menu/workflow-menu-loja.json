                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "endereco"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "leftValue": "={{ $json.opcao }}", "rightValue": "pessoa", "operator": { "type": "string", "operation": "equals" } }
                ],
