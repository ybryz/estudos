{
  "name": "busca-cep-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Back-end do Busca CEP com histórico de buscas em SQLite (Prisma)",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "db:preparar": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio --url file://./prisma/dev.db"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
